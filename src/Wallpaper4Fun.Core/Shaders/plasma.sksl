// Plasma colorido clássico. Mesmo desenho do shader "plasma" da versão Mac.
uniform float2 iResolution;
uniform float iTime;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.y;
    float2 center = float2(iResolution.x / iResolution.y * 0.5, 0.5);
    float t = iTime * 0.6;

    float v = sin(uv.x * 5.0 + t)
            + sin((uv.y * 5.0 + t) * 0.8)
            + sin((uv.x + uv.y) * 4.0 + t * 1.3)
            + sin(length(uv - center) * 9.0 - t * 1.7);

    float3 col = 0.5 + 0.5 * cos(float3(0.0, 2.1, 4.2) + v * 1.1 + t * 0.4);
    return half4(half3(col * 0.85), 1.0);
}
