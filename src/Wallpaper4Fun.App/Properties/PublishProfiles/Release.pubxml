<Project>
  <!--
    Como o app é publicado, num lugar só: usado por tools/publish.sh (Mac) e pelo
    .github/workflows/release.yml (Windows). O processador vem da linha de comando (-r win-x64).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- Leva o .NET junto: o PC não precisa ter nada instalado. -->
    <SelfContained>true</SelfContained>
    <!-- Arquivos soltos, nunca .exe único: a v1.0.1 (arquivo único comprimido) não abria no Windows 10. -->
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>None</DebugType>
  </PropertyGroup>
</Project>
