<Project Sdk="Microsoft.NET.Sdk">

  <!-- Camada Windows: janelas atrás dos ícones, bandeja, painel e renderização. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 (19041) ou mais novo: exigido pelo SkiaSharp.Views.WPF. -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone da bandeja (NotifyIcon) e a lista de monitores (Screen). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>wallpaper4fun</AssemblyName>
    <RootNamespace>Wallpaper4Fun.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe. Gerado a partir de design/icon/*.svg (veja CLAUDE.md). -->
    <ApplicationIcon>Assets\wallpaper4fun.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF e Windows Forms juntos têm tipos com o mesmo nome; usamos os do Forms só com nome completo. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Também embutido como recurso WPF, para a janela do painel e a bandeja. -->
    <Resource Include="Assets\wallpaper4fun.ico" />
    <!-- Vídeos padrão: copiados para a pasta Videos ao lado do .exe (veja VideoCatalog). -->
    <Content Include="Videos\*.mp4;Videos\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wallpaper4Fun.Core\Wallpaper4Fun.Core.csproj" />
  </ItemGroup>

</Project>
